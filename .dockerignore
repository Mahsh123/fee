# The build context must never contain secrets or local state.
**/.env
**/.env.*
!**/.env.example

# Dependencies and build output are produced inside the image.
**/node_modules
**/dist
**/.next
**/.turbo
**/*.tsbuildinfo

# The Prisma client is generated during the image build.
packages/database/src/generated

# Local tooling caches (relocated here on this machine because the system drive is full).
.npm-cache
.tmp

# Tests and documentation are not needed to build or run.
**/coverage
**/test-results
**/playwright-report
docs
.github

# Version control and editor state
.git
.gitignore
**/.DS_Store
**/.idea
**/.vscode
**/logs
**/*.log
