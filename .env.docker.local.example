# Copy to .env.docker.local and replace with a random local development secret.
# This is shared only by the local Compose API and notification worker.
NOTIFICATION_WORKER_HMAC_SECRET=replace-with-a-long-random-local-secret

# The one-shot development seeder creates tenant administrator accounts for demo, school, academy, and gym.
# Use a local-only temporary password of at least 12 characters; never reuse a real password.
SEED_DEMO_EMAIL=admin@demo-academy.test
SEED_SCHOOL_EMAIL=admin@northstar.test
SEED_ACADEMY_EMAIL=admin@greenfield-academy.test
SEED_GYM_EMAIL=manager@northstar-fitness.test
SEED_DEMO_PASSWORD=
