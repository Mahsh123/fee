# =====================================================================================
# Fee Platform - environment configuration
# Copy to `.env` for local development. Never commit a real `.env`.
# =====================================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api
API_VERSION=v1
WEB_APP_URL=http://platform.localhost:3000
CORS_ORIGINS=http://platform.localhost:3000
PLATFORM_SUBDOMAIN=platform
TENANT_BASE_DOMAIN=localhost
NEXT_PUBLIC_API_BASE_URL=http://platform.localhost:8080/api/v1

# ---------------------------------------------------------------------------
# Datastore
# ---------------------------------------------------------------------------
# Plain `docker compose up` automatically reads this root .env file. Set this to
# the pooled fee_runtime URL from Neon before starting the local container stack.
# Host-based development keeps its URL in .env.neon.local. Never use an owner or
# migration credential for application runtime.
DATABASE_URL=postgresql://fee_runtime:replace-with-runtime-password@ep-example-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Redis is cache / queue / rate-limit ONLY. It is never the financial source of truth.
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=fee
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_MS=2000
# Share this random secret only between the API and notification worker.
NOTIFICATION_WORKER_HMAC_SECRET=replace-with-shared-random-worker-hmac-secret
# Local worker callback target; Compose overrides this with the API service URL.
NOTIFICATION_CALLBACK_URL=http://localhost:4000/api/v1/internal/notifications/delivery-result

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=replace-me-with-a-different-32-char-secret
JWT_REFRESH_TTL=2592000
# 32-byte key, base64 or hex. Encrypts gateway secrets at rest (AES-256-GCM).
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Optional until signed audit cutover. Versioned random 32-byte keys are copied
# by the one-shot migration key provisioner into the owner-only verifier table.
AUDIT_SIGNING_KEYS_JSON=
AUDIT_ACTIVE_SIGNING_KEY_VERSION=1
AUDIT_ENVELOPE_MAX_LIFETIME_MS=30000
AUDIT_ENVELOPE_CLOCK_SKEW_MS=5000

# ---------------------------------------------------------------------------
# Bootstrap (first-run only; these values are sent only to the one-shot seed process)
# Platform operators sign in at platform.<TENANT_BASE_DOMAIN>; tenants use <slug>.<TENANT_BASE_DOMAIN>.
# ---------------------------------------------------------------------------
SEED_PLATFORM_ADMIN_EMAIL=admin@example.com
SEED_PLATFORM_ADMIN_PASSWORD=
SEED_DEMO_TENANT=false
# Development-only tenant administrator accounts for the sample hosts below.
# Set this local temporary password to create those accounts; it is never logged.
SEED_DEMO_EMAIL=admin@demo-academy.test
SEED_SCHOOL_EMAIL=admin@northstar.test
SEED_ACADEMY_EMAIL=admin@greenfield-academy.test
SEED_GYM_EMAIL=manager@northstar-fitness.test
SEED_DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# Object storage (S3-compatible or Azure Blob via gateway)
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=fee-platform-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL=900

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Fee Platform <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Payment gateways.
# Platform-level defaults are optional: each tenant configures its own keys in
# the database, encrypted with ENCRYPTION_KEY. These are only used by the mock
# provider and local sandbox testing.
# ---------------------------------------------------------------------------
PAYMENT_DEFAULT_PROVIDER=MOCK
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
PAYU_KEY=
PAYU_SALT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Queues
# ---------------------------------------------------------------------------
QUEUE_PREFIX=fee
WORKER_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_MS=2000

# Provider status reconciliation: unresolved/unknown checkouts keep their
# reservation and are retried with bounded exponential backoff.
GATEWAY_STATUS_POLL_INTERVAL_MS=60000
GATEWAY_STATUS_MAX_AUTO_ATTEMPTS=8
GATEWAY_STATUS_RETRY_INITIAL_MS=300000
GATEWAY_STATUS_RETRY_MAX_MS=21600000
GATEWAY_STATUS_LEASE_MS=90000

# SaaS subscription lifecycle: automatically issue renewal invoices, expire
# trials, mark overdue invoices, and suspend accounts after the grace period.
PLATFORM_SUBSCRIPTION_LIFECYCLE_POLL_INTERVAL_MS=60000
PLATFORM_INVOICE_DUE_DAYS=30
PLATFORM_BILLING_GRACE_DAYS=7

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fee-platform-api

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
WEBHOOK_RATE_LIMIT_MAX=600
