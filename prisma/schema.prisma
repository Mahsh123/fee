// =====================================================================================
// Fee Platform - Domain Schema
// =====================================================================================
//
// Design rules encoded in this schema:
//
//   1. Every tenant-owned table carries `tenantId` and a real foreign key to Tenant.
//   2. Money is NEVER a float. All monetary columns are `Decimal @db.Decimal(18,4)`.
//      Four decimal places let the engine hold exact intermediate values for
//      percentage rules; presentation rounding happens at the edge.
//   3. The financial lifecycle is stored as separate concepts and is never merged:
//         FeeType -> FeeStructure -> FeePolicy -> FeeAssignment -> FeeDemand
//         FeeDemand -> PaymentOrder -> Payment -> PaymentAllocation -> Ledger -> Receipt
//   4. Issued financial records are immutable. Corrections happen through
//      Refund / Adjustment / Credit / Reversal rows, never by editing history.
//   5. Tamper-evidence: uniques on (tenantId, receiptNumber), (tenantId, invoiceNumber),
//      (tenantId, provider, environment, externalEventId) for signature-verified
//      webhooks and (tenantId, provider, providerTxnId) make duplicate receipts and
//      gateway postings impossible at the database level.
//   6. Configurable objects use `active` / archival instead of hard delete. Financial
//      rows are never soft-deleted.
// =====================================================================================

generator client {
  provider        = "prisma-client"
  output          = "../packages/database/src/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

