# Copy to .env.production and replace every placeholder with deployment secrets.

NODE_ENV=production

# Build the API and worker from the production-runtime target; keep migration and
# platform bootstrap on the separate full-tooling operations target.
API_IMAGE=fee-platform/api:latest
WORKER_IMAGE=fee-platform/worker:latest
MIGRATION_IMAGE=fee-platform/operations:latest

# Neon target identity. Use the direct endpoint here; the API URL below uses
# Neon's pooled endpoint. Keep the database and schema identical in every URL.
DATABASE_TARGET_HOST=ep-example.ap-southeast-1.aws.neon.tech
DATABASE_TARGET_PORT=5432
DATABASE_TARGET_NAME=neondb
DATABASE_TARGET_SCHEMA=public

# Pre-provision these distinct roles and grants through the Neon managed database
# workflow before deployment. The API URL is pooled; migration and backup use direct.
MIGRATION_DATABASE_ROLE=fee_migrator
RUNTIME_DATABASE_ROLE=fee_runtime
BACKUP_DATABASE_ROLE=fee_backup
BACKUP_DATABASE_PASSWORD=replace-with-a-third-long-random-backup-secret
DATABASE_URL=postgresql://fee_runtime:replace-with-runtime-password@ep-example-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
MIGRATION_DATABASE_URL=postgresql://fee_migrator:replace-with-migration-password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# One-shot only: never add this URL to API, worker, or web environments.
PLATFORM_BOOTSTRAP_DATABASE_URL=postgresql://neondb_owner:replace-with-owner-password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# age public recipient used to encrypt each logical backup before it reaches the
# persistent backup volume. Keep its private identity outside this deployment.
BACKUP_AGE_RECIPIENT=age1replace-with-the-production-recipient

REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_URL=redis://:replace-with-a-long-random-redis-password@redis:6379
# A distinct 32-byte random secret shared only by API and email worker.
NOTIFICATION_WORKER_HMAC_SECRET=replace-with-a-long-random-worker-callback-secret
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Configure through the production secret manager before audit v2 cutover.
# The one-shot migration service provisions the verifier copy; the API uses the signer copy.
# Example shape: {"1":"64-lowercase-or-uppercase-hex-characters"}
AUDIT_SIGNING_KEYS_JSON=
AUDIT_ACTIVE_SIGNING_KEY_VERSION=1
AUDIT_ENVELOPE_MAX_LIFETIME_MS=30000
AUDIT_ENVELOPE_CLOCK_SKEW_MS=5000
# First deployment only: the one-shot platform bootstrap receives the owner URL
# and these operator credentials. Remove the password after bootstrap; repeat
# deployments preserve the existing platform account.
SEED_PLATFORM_ADMIN_EMAIL=admin@example.com
SEED_PLATFORM_ADMIN_PASSWORD=
# Platform administration and tenant workspaces share the base domain and proxy;
# tenants use <slug>.example.com and the platform label is configurable.
PLATFORM_SUBDOMAIN=platform
TENANT_BASE_DOMAIN=example.com
WEB_APP_URL=https://platform.example.com
CORS_ORIGINS=https://platform.example.com
NEXT_PUBLIC_API_BASE_URL=https://platform.example.com/api/v1
GATEWAY_STATUS_POLL_INTERVAL_MS=60000
GATEWAY_STATUS_MAX_AUTO_ATTEMPTS=8
GATEWAY_STATUS_RETRY_INITIAL_MS=300000
GATEWAY_STATUS_RETRY_MAX_MS=21600000
GATEWAY_STATUS_LEASE_MS=90000
QUEUE_PREFIX=fee
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_MS=2000
