{
  "name": "@fee/api",
  "version": "1.0.0",
  "private": true,
  "description": "Fee platform API - modular monolith with strict domain boundaries.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.mts",
    "test:watch": "vitest",
    "clean": "node ../../scripts/clean-workspace.mjs dist tsbuildinfo"
  },
  "dependencies": {
    "@fee/config": "*",
    "@fee/database": "*",
    "@fee/dates": "*",
    "@fee/fee-engine": "*",
    "@fee/logger": "*",
    "@fee/money": "*",
    "@fee/notifications": "*",
    "@fee/payment-contracts": "*",
    "@fee/receipts": "*",
    "@fee/types": "*",
    "@fee/validation": "*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.9",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
