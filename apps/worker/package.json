{
  "name": "@fee/worker",
  "version": "1.0.0",
  "private": true,
  "description": "Background worker: receipts, notifications, reminders, reports, exports, webhook retries, reconciliation.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.mts",
    "clean": "node ../../scripts/clean-workspace.mjs dist tsbuildinfo",
    "test:watch": "vitest --config ../../vitest.config.mts"
  },
  "dependencies": {
    "@fee/config": "*",
    "@fee/dates": "*",
    "@fee/logger": "*",
    "@fee/money": "*",
    "@fee/notifications": "*",
    "@fee/receipts": "*",
    "@fee/types": "*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "bullmq": "^6.3.9",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.11",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
